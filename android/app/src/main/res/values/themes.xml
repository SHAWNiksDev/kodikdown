<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.KodikDown" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/app_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">?attr/app_background</item>
        <item name="android:windowBackground">?attr/app_background</item>

        <!-- Material3 mappings -->
        <item name="colorPrimary">@color/light_accent</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_text</item>
        <item name="colorOutline">@color/light_border</item>

        <!-- Custom Palette mappings (Light default) -->
        <item name="app_background">@color/light_background</item>
        <item name="app_surface">@color/light_surface</item>
        <item name="app_surface_alt">@color/light_surface_alt</item>
        <item name="app_border">@color/light_border</item>
        <item name="app_border_strong">@color/light_border_strong</item>
        <item name="app_text">@color/light_text</item>
        <item name="app_text_muted">@color/light_text_muted</item>
        <item name="app_accent">@color/light_accent</item>
        <item name="app_accent_hover">@color/light_accent_hover</item>
        <item name="app_accent_soft">@color/light_accent_soft</item>
        <item name="app_success">@color/light_success</item>
        <item name="app_danger">@color/light_danger</item>
        <item name="app_warning">@color/light_warning</item>
    </style>
</resources>
