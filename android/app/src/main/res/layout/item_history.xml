<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Title + Status Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvHistoryTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/app_text"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="Sousou no Frieren Episode 1" />

        <TextView
            android:id="@+id/tvHistoryStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_badge"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:textColor="?attr/app_success"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="Завершено" />
    </LinearLayout>

    <!-- Subtitle: Quality, Translation, Date, Size -->
    <TextView
        android:id="@+id/tvHistoryMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/app_text_muted"
        android:textSize="11sp"
        tools:text="720p • AniLibria • 142.5 МБ • 18 окт., 20:45" />

    <!-- Error message if failed -->
    <TextView
        android:id="@+id/tvHistoryError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="?attr/app_danger"
        android:textSize="11sp"
        android:visibility="gone"
        tools:text="Ошибка сети: Timeout" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Re-download Button -->
        <LinearLayout
            android:id="@+id/btnHistoryRedownload"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_download"
                app:tint="?attr/app_accent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/download_again"
                android:textColor="?attr/app_accent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Play Button (visible if file exists) -->
        <LinearLayout
            android:id="@+id/btnHistoryPlay"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button_secondary"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/ic_play"
                app:tint="?attr/app_text" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/play"
                android:textColor="?attr/app_text"
                android:textSize="11sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Copy Link Button -->
        <ImageView
            android:id="@+id/btnHistoryCopy"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_button_secondary"
            android:contentDescription="@string/copy_link"
            android:padding="7dp"
            android:src="@drawable/ic_copy"
            app:tint="?attr/app_text_muted" />

        <!-- Delete from history Button -->
        <ImageView
            android:id="@+id/btnHistoryDelete"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_button_secondary"
            android:contentDescription="@string/remove"
            android:padding="8dp"
            android:src="@drawable/ic_close"
            app:tint="?attr/app_text_muted" />
    </LinearLayout>

</LinearLayout>
